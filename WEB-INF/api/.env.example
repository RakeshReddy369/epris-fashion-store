PORT=3000
JWT_SECRET=replace_with_a_long_random_secret_in_production
CORS_ORIGIN=http://127.0.0.1:5500
# MongoDB Database (Atlas Cloud or Local)
# Atlas Example: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/epris_fashion?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/epris_fashion?retryWrites=true&w=majority

# Google Sign-In (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Facebook Login (Meta for Developers)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Admin Account (run POST /api/admin/seed once)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!2026

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=EPRIS Fashion <your-email@gmail.com>
